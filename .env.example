# Supabase Configuration for Dastaras Portal
# ان کریڈینشلز کو سپابیس ڈیش بورڈ سے حاصل کریں (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (اختیاری: کرون جابز اور ایڈمن کے لیے)

# Google Gemini API برائے خودکار نیوز ری رائٹنگ (AI Automated News Rewriting)
# https://aistudio.google.com سے مفت حاصل کریں
GEMINI_API_KEY=your-gemini-api-key-here

# Vercel Cron Secret برائے خودکار کرون جاب پروٹیکشن (/api/cron/fetch-news)
CRON_SECRET=your-secure-cron-secret-token

